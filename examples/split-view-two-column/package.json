{
  "name": "navigator-example-split-view-two-column",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "generate:navigator": "ankh navigator generate --manifest navigator.manifest.json --bindings navigator.bindings.json --platform ios --expo-router-version 57.0.18 --target ."
  },
  "dependencies": {
    "@ankhorage/navigator": "3.2.0",
    "expo": "^57.0.20",
    "expo-router": "57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.8.11",
    "@types/react": "^19.2.18",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
