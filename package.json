{
  "name": "@ankhorage/navigator",
  "version": "3.4.0",
  "description": "Standalone manifest-driven navigator capability for Expo Router across React Native and React Native Web.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://github.com/ankhorage/navigator#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/navigator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/navigator.git"
  },
  "keywords": [
    "ankhorage",
    "react-native",
    "react-native-web",
    "expo",
    "expo-router",
    "navigator",
    "navigation",
    "tabs",
    "drawer",
    "responsive",
    "typescript"
  ],
  "main": "./dist/navigator.js",
  "types": "./dist/navigator.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/navigator.d.ts",
      "default": "./dist/navigator.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    },
    "./cli": {
      "types": "./dist/cli/createCliProvider.d.ts",
      "default": "./dist/cli/createCliProvider.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    },
    "./tabs": {
      "types": "./dist/features/tabs/tabs.d.ts",
      "default": "./dist/features/tabs/tabs.js"
    },
    "./tabs/native-icons": {
      "types": "./dist/features/tabs/nativeIcons.d.ts",
      "default": "./dist/features/tabs/nativeIcons.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "default": "./dist/workspace.js"
    },
    "./package.json": "./package.json"
  },
  "ankh": {
    "category": "navigator",
    "provider": "./dist/cli/createCliProvider.js",
    "capabilities": [
      {
        "id": "navigator.catalog",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "navigator.validate",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "navigator.plan",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "navigator.generate",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "navigator.verify",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "navigator.examples.generate",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "navigator.examples.verify",
        "owner": "@ankhorage/navigator",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      }
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "examples:generate": "bun run build && bun scripts/run-local-example-provider.ts generate --target . && bun run format",
    "examples:exports": "bun scripts/verify-example-exports.ts",
    "examples:browser": "bun scripts/verify-example-browser.ts",
    "examples:local-scroll": "bun scripts/verify-headless-tabs-scroll.ts",
    "examples:acceptance": "bun run examples:validate && bun run examples:exports && bun run examples:browser && bun run examples:local-scroll",
    "examples:validate": "bun scripts/validate-example-projects.ts",
    "examples:synchronize": "bun run examples:generate && bun scripts/synchronize-example-lockfiles.ts",
    "examples:verify": "bun run build && bun scripts/run-local-example-provider.ts verify --target .",
    "test": "bun test src tests",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p tsconfig.scripts.json",
    "version-packages": "ankhorage-changeset version",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "release:synchronize": "bun run examples:synchronize && bun run docs && bun run format"
  },
  "dependencies": {
    "@ankhorage/contracts": "^24.1.0",
    "@ankhorage/utility": "^1.9.85"
  },
  "peerDependencies": {
    "@ankhorage/surface": "^9.1.7",
    "@react-native-vector-icons/fontawesome": "^13.1.4",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "expo-router": ">=57.0.0 <58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.x",
    "react-native-gesture-handler": "*",
    "react-native-pager-view": "9.0.6",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "~5.7.0 || ~5.10.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-pager-view": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-tab-view": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.12.0",
    "@ankhorage/devtools": "^2.0.115",
    "@ankhorage/paradox": "^0.3.0",
    "@ankhorage/surface": "^9.3.3",
    "@playwright/test": "^1.63.0",
    "@react-native-vector-icons/fontawesome": "^13.1.4",
    "@react-native-vector-icons/fontawesome5": "^13.1.4",
    "@react-native-vector-icons/fontawesome6": "^13.1.4",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "expo": "^57.0.26",
    "expo-router": "57.0.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-pager-view": "9.0.6",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-tab-view": "^4.3.3",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "^0.13.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
