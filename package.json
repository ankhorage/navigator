{
  "name": "@ankhorage/navigator",
  "version": "3.0.0",
  "description": "Standalone manifest-driven navigator capability for Expo Router across React Native and React Native Web.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://github.com/ankhorage/navigator#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/navigator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/navigator.git"
  },
  "keywords": [
    "ankhorage",
    "react-native",
    "react-native-web",
    "expo",
    "expo-router",
    "navigator",
    "navigation",
    "tabs",
    "drawer",
    "responsive",
    "typescript"
  ],
  "main": "./dist/navigator.js",
  "types": "./dist/navigator.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/navigator.d.ts",
      "default": "./dist/navigator.js"
    },
    "./metadata": {
      "types": "./dist/utils/NAVIGATOR_PACKAGE_METADATA.d.ts",
      "default": "./dist/utils/NAVIGATOR_PACKAGE_METADATA.js"
    },
    "./cli": {
      "types": "./dist/cli/createCliProvider.d.ts",
      "default": "./dist/cli/createCliProvider.js"
    },
    "./tabs": {
      "types": "./dist/features/tabs/tabs.d.ts",
      "default": "./dist/features/tabs/tabs.js"
    },
    "./tabs/native-icons": {
      "types": "./dist/features/tabs/nativeIcons.d.ts",
      "default": "./dist/features/tabs/nativeIcons.js"
    },
    "./package.json": "./package.json"
  },
  "ankh": {
    "category": "navigator",
    "provider": "./dist/cli/createCliProvider.js",
    "capabilities": [
      "navigator.catalog",
      "navigator.validate",
      "navigator.plan",
      "navigator.generate",
      "navigator.verify",
      "navigator.examples.generate",
      "navigator.examples.verify"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "examples:generate": "bun run build && ankh navigator examples generate --target . && bun run format",
    "examples:exports": "bun scripts/verify-example-exports.ts",
    "examples:browser": "bun scripts/verify-example-browser.ts",
    "examples:acceptance": "bun run examples:validate && bun run examples:exports && bun run examples:browser",
    "examples:validate": "bun scripts/validate-example-projects.ts",
    "examples:verify": "bun run build && ankh navigator examples verify --target .",
    "test": "bun test src tests",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p tsconfig.scripts.json",
    "version-packages": "ankhorage-changeset version",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/contracts": "^12.0.1",
    "@ankhorage/utility": "^0.4.0"
  },
  "peerDependencies": {
    "@ankhorage/surface": "^3.4.4",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "expo-router": ">=57.0.0 <58.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.x",
    "react-native-gesture-handler": "*",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-pager-view": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-tab-view": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.8.11",
    "@ankhorage/devtools": "^1.12.0",
    "@ankhorage/paradox": "^0.1.24",
    "@ankhorage/surface": "^3.4.4",
    "@playwright/test": "^1.63.0",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "expo": "^57.0.20",
    "expo-router": "57.0.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-worklets": "^0.12.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
