{
  "name": "@ankhorage/zora-navigation",
  "version": "0.0.0",
  "description": "Responsive, theme-aware navigation components for ZORA on React Native and React Native Web.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://github.com/ankhorage/zora-navigation#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/zora-navigation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/zora-navigation.git"
  },
  "keywords": [
    "ankhorage",
    "zora",
    "react-native",
    "react-native-web",
    "expo",
    "expo-router",
    "navigation",
    "tabs",
    "drawer",
    "responsive",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "docs": "paradox",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.6.0",
    "@ankhorage/paradox": "^0.1.22",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
