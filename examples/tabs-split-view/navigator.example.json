{
  "id": "tabs-split-view",
  "title": "Tabs → Split View",
  "description": "Explicit unsupported case: Split View cannot be nested beneath Tabs.",
  "targets": [
    {
      "platform": "android",
      "support": "unsupported",
      "capabilityIds": ["split-view.two-column", "tabs.javascript.bottom"],
      "diagnostics": [
        {
          "code": "invalid-split-view-placement",
          "severity": "error",
          "path": "/routes/1/navigator",
          "message": "Split View is allowed only at the root or beneath Slot-only ancestry with no other navigator."
        },
        {
          "code": "unsupported-platform",
          "severity": "error",
          "path": "/routes/1/navigator",
          "message": "Split View is unavailable on android; Expo Router's Slot fallback is not a split-pane capability."
        }
      ],
