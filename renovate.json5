/***
 * Repository configuration
 *
 * Loads the canonical Ankhorage dependency-update policy from its default branch.
 *
 */
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>ankhorage/renovate'],
  packageRules: [
    {
      description: 'Expo SDK 57 platform React contract',
      matchDepTypes: ['devDependencies', 'peerDependencies'],
      matchPackageNames: ['react', 'react-dom'],
      allowedVersions: '19.2.3',
    },
  ],
}
