{
  "name": "@ankhorage/navigator",
  "version": "0.1.1",
  "description": "Standalone manifest-driven navigator capability for Expo Router across React Native and React Native Web.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://github.com/ankhorage/navigator#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/navigator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/navigator.git"
  },
  "keywords": [
    "ankhorage",
    "react-native",
    "react-native-web",
    "expo",
    "expo-router",
    "navigator",
    "navigation",
    "tabs",
    "drawer",
    "responsive",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/contracts": "^10.1.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.10.16",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.1"
}
